{
  "name": "@moonetix/react-native-offerwall",
  "version": "2.0.1",
  "description": "Show the Moonetix offerwall in your React Native or Expo app. Your server creates a single-use session, and the package opens the native Moonetix Android and iOS SDK with it. No key ships inside your app.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "android/src",
    "ios/*.h",
    "ios/*.m",
    "ios/*.mm",
    "ios/Frameworks",
    "plugin",
    "app.plugin.js",
    "moonetix-react-native-offerwall.podspec",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "pack:example": "npm pack --silent && mv moonetix-react-native-offerwall-$npm_package_version.tgz moonetix-react-native-offerwall.tgz"
  },
  "keywords": [
    "react-native",
    "expo",
    "offerwall",
    "rewarded",
    "monetization",
    "android",
    "ios",
    "moonetix"
  ],
  "homepage": "https://docs.moonetix.com/react-native-sdk",
  "bugs": {
    "url": "https://moonetix.com/contact"
  },
  "author": "Moonetix <partners@moonetix.com> (https://moonetix.com)",
  "license": "Apache-2.0",
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": ">=0.77.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@react-native/codegen": "0.88.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "babel-jest": "30.5.2",
    "jest": "30.5.2",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "codegenConfig": {
    "name": "RNMoonetixOfferwallSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.moonetix.offerwall.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "MoonetixOfferwall": "RNMoonetixOfferwall"
      }
    }
  }
}
